{
  "manifest_version": 2,
  "name": "Family Safe Browser Extension",
  "version": "1.0",
  "description": "Family-safe browser extension that blocks adult content using multiple filtering layers",
  "incognito": "spanning",
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Family Safe (protection always on)"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["blocklist.js", "background.js"],
    "persistent": true
  },
  "web_accessible_resources": [
    "blocked.html"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["blocklist.js", "content_script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
